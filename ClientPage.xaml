<Page x:Class="БаязитовЛангуге.ClientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:БаязитовЛангуге"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="Клиенты" FontFamily="Comic Sans MS" IsVisibleChanged="Page_IsVisibleChanged">
    <Page.Resources>
        <local:ImagePathConverter x:Key="ImagePathConverter"/>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" FontSize="14" Margin="0,0,10,0"/>
            <TextBox x:Name="SearchTextBox" Width="300" Height="30" TextChanged="SearchTextBox_TextChanged"/>
            <TextBlock Text="Фильтр:" VerticalAlignment="Center" FontSize="14" Margin="0,0,10,0"/>
            <ComboBox x:Name="FilterComboBox" Width="200" Height="30" SelectionChanged="FilterComboBox_SelectionChanged"
          DisplayMemberPath="Title">
                <ComboBoxItem>Все</ComboBoxItem>
                <ComboBoxItem>Мужской</ComboBoxItem>
                <ComboBoxItem>Женский</ComboBoxItem>
            </ComboBox>
            <TextBlock Text="Сортировка:" VerticalAlignment="Center" FontSize="14" Margin="0,0,10,0"/>
            <ComboBox x:Name="SortComboBox" Width="250" Height="30" SelectionChanged="SortComboBox_SelectionChanged">
                <ComboBoxItem Tag="NameAsc">Нет</ComboBoxItem>
                <ComboBoxItem Tag="NameDesc">Фамилия (А-Я)</ComboBoxItem>
                <ComboBoxItem Tag="DiscountAsc">Кол-во посещений (по убыванию)</ComboBoxItem>
                <ComboBoxItem Tag="DiscountDesc">По дате последнего посещения</ComboBoxItem>
            </ComboBox>
            <Button Content="Добавить" Name="AddBtn" Click="AddBtn_Click"></Button>
        </StackPanel>
        

        <ListView Grid.Row="1" Name="ClientListView" >
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>
                        <Image Grid.Column="0" Grid.RowSpan="8" Width="200" Stretch="UniformToFill" HorizontalAlignment="Left" 
                               Source="{Binding PhotoPath, Converter={StaticResource ImagePathConverter}}"/>
                        <StackPanel  Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" Orientation="Horizontal">
                            <TextBlock Text="ID: " FontSize="20"></TextBlock>
                            <TextBlock Text="{Binding ID}" FontSize="20" Margin="0,0,5,0"></TextBlock>
                            <TextBlock Text="{Binding LastName}" FontSize="20" Margin="0,0,5,0"></TextBlock>
                            <TextBlock Text="{Binding FirstName}" FontSize="20"  Margin="0,0,5,0"></TextBlock>
                            <TextBlock Text="{Binding Patronymic}" FontSize="20"  Margin="0,0,5,0"></TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" Orientation="Horizontal">
                            <TextBlock Text="Пол: " FontSize="20"></TextBlock>
                            <TextBlock Text="{Binding GenderCode}" FontSize="20" Margin="0,0,5,0"></TextBlock>
                            <TextBlock Text="Дата рождения: " FontSize="20" Margin="0,0,5,0"></TextBlock>
                            <TextBlock Text="{Binding BirthdayString}" FontSize="20" Margin="0,0,5,0"></TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" Orientation="Horizontal">
                            <TextBlock Text="Телефон: " FontSize="20"></TextBlock>
                            <TextBlock Text="{Binding Phone}" FontSize="20" Margin="0,0,5,0"></TextBlock>
                            <TextBlock Text="e-mail: " FontSize="20"></TextBlock>
                            <TextBlock Text="{Binding Email}" FontSize="20" Margin="0,0,5,0"></TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left" Orientation="Horizontal">
                            <TextBlock Text="Дата регистрации: " FontSize="20"></TextBlock>
                            <TextBlock Text="{Binding RegistrationDateString}" FontSize="20" Margin="0,0,5,0"></TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="4" HorizontalAlignment="Left" Orientation="Horizontal">
                            <TextBlock Text="Дата послледнего посещения: " FontSize="20"></TextBlock>
                            <TextBlock Text="{Binding LastVisitDate}" FontSize="20"></TextBlock>
                            <TextBlock Text="  Количество посещений: " FontSize="20"></TextBlock>
                            <TextBlock Text="{Binding VisitsCount}" FontSize="20"></TextBlock>
                        </StackPanel>
                        
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Button Content="Удалить" Name="DeleteBtn" Grid.Row="2"  HorizontalAlignment="Left" VerticalAlignment="Center"
                Click="DeleteBtn_Click" Width="100" Visibility="Visible"></Button>

            <Button Content="Редактировать" Name="EditBtn" Click="EditBtn_Click"  Width="150" Visibility="Visible"></Button>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Name="TBCount" FontSize="20"  VerticalAlignment="Center" ></TextBlock>
            <TextBlock Name="TBALLRecords" FontSize="20"   VerticalAlignment="Center"></TextBlock>
            <TextBlock Text="  Выводить по " FontSize="20"></TextBlock>
            <ComboBox Name="PageListCB" Height="30" Width="70" SelectionChanged="PageListCB_SelectionChanged">
                <TextBlock>10</TextBlock>
                <TextBlock>50</TextBlock>
                <TextBlock>200</TextBlock>
                <TextBlock>Все</TextBlock>
            </ComboBox>
            <Button Name="LeftDirButton" Content="&lt;" Width="30" Height="30"
                    Click="LeftDirButton_Click"></Button>
            <ListBox FontSize="30" Name="PageListBox" MouseUp="PageListBox_MouseUp">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <Button Name="RightDirButton" Content="&gt;" Width="30" Height="30"
                    Click="RightDirButton_Click"></Button>
        </StackPanel>
    </Grid>
</Page>
